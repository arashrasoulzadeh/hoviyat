package repository

import (
	"context"
	"testing"
	"time"

	"github.com/arashrasoulzadeh/hoviyat/backend/internal/domain"
	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
)

type fakeAuditLogRepository struct {
	logs   map[string]*domain.AuditLog
	counter int
}

func newFakeAuditLogRepository() *fakeAuditLogRepository {
	return &fakeAuditLogRepository{
		logs:   make(map[string]*domain.AuditLog),
		counter: 0,
	}
}

func (f *fakeAuditLogRepository) Create(_ context.Context, log *domain.AuditLog) error {
	if log.ID == "" {
		f.counter++
		log.ID = log.TenantID + "-audit-" + time.Now().Format("150405.000000000") + string(rune('A'+f.counter))
	}
	if _, exists := f.logs[log.ID]; exists {
		return domain.ErrAuditLogNotFound
	}
	f.logs[log.ID] = log
	return nil
}

func (f *fakeAuditLogRepository) FindByID(_ context.Context, id string) (*domain.AuditLog, error) {
	log, ok := f.logs[id]
	if !ok {
		return nil, domain.ErrAuditLogNotFound
	}
	return log, nil
}

func (f *fakeAuditLogRepository) List(_ context.Context, filter domain.AuditLogFilter) ([]*domain.AuditLog, error) {
	var out []*domain.AuditLog
	for _, log := range f.logs {
		if filter.TenantID != "" && log.TenantID != filter.TenantID {
			continue
		}
		if len(filter.EventTypes) > 0 {
			found := false
			for _, et := range filter.EventTypes {
				if log.EventType == et {
					found = true
					break
				}
			}
			if !found {
				continue
			}
		}
		if filter.ActorID != "" && log.ActorID != filter.ActorID {
			continue
		}
		if filter.ResourceType != "" && log.ResourceType != filter.ResourceType {
			continue
		}
		if filter.ResourceID != "" && log.ResourceID != filter.ResourceID {
			continue
		}
		if !filter.StartTime.IsZero() && log.Timestamp.Before(filter.StartTime) {
			continue
		}
		if !filter.EndTime.IsZero() && log.Timestamp.After(filter.EndTime) {
			continue
		}
		out = append(out, log)
	}
	return out, nil
}

func (f *fakeAuditLogRepository) Count(_ context.Context, filter domain.AuditLogFilter) (int64, error) {
	logs, _ := f.List(context.Background(), filter)
	return int64(len(logs)), nil
}

func (f *fakeAuditLogRepository) VerifyChain(_ context.Context, tenantID string, fromTimestamp time.Time) (bool, error) {
	// Simplified - always return true for fake
	return true, nil
}

func TestAuditLogRepository_Create(t *testing.T) {
	repo := newFakeAuditLogRepository()

	log := &domain.AuditLog{
		TenantID:  "tenant-1",
		EventType: domain.AuditEventTypeUserCreated,
		ActorID:   "user-1",
		ActorType: "user",
		Action:    "User created via registration",
		Before:    map[string]any{},
		After:     map[string]any{"email": "test@example.com"},
		Metadata:  map[string]any{"ip": "192.168.1.1"},
	}

	err := repo.Create(context.Background(), log)
	assert.NoError(t, err)
	assert.NotEmpty(t, log.ID)
	assert.NotEmpty(t, log.Hash)
}

func TestAuditLogRepository_FindByID(t *testing.T) {
	repo := newFakeAuditLogRepository()

	log := &domain.AuditLog{
		TenantID:  "tenant-1",
		EventType: domain.AuditEventTypeUserLogin,
		ActorID:   "user-1",
		ActorType: "user",
		Action:    "User logged in",
	}
	err := repo.Create(context.Background(), log)
	require.NoError(t, err)

	found, err := repo.FindByID(context.Background(), log.ID)
	assert.NoError(t, err)
	assert.Equal(t, log.ID, found.ID)
	assert.Equal(t, log.EventType, found.EventType)
}

func TestAuditLogRepository_FindByID_NotFound(t *testing.T) {
	repo := newFakeAuditLogRepository()

	_, err := repo.FindByID(context.Background(), "non-existent")
	assert.ErrorIs(t, err, domain.ErrAuditLogNotFound)
}

func TestAuditLogRepository_List(t *testing.T) {
	repo := newFakeAuditLogRepository()

	logs := []*domain.AuditLog{
		{TenantID: "tenant-1", EventType: domain.AuditEventTypeUserCreated, ActorID: "user-1", Action: "Created"},
		{TenantID: "tenant-1", EventType: domain.AuditEventTypeUserLogin, ActorID: "user-2", Action: "Logged in"},
		{TenantID: "tenant-2", EventType: domain.AuditEventTypeUserCreated, ActorID: "user-3", Action: "Created"},
	}

	for _, log := range logs {
		repo.Create(context.Background(), log)
	}

	// Filter by tenant
	filter := domain.AuditLogFilter{TenantID: "tenant-1"}
	logs, err := repo.List(context.Background(), filter)
	assert.NoError(t, err)
	assert.Len(t, logs, 2)

	// Filter by event type
	filter = domain.AuditLogFilter{TenantID: "tenant-1", EventTypes: []domain.AuditEventType{domain.AuditEventTypeUserLogin}}
	logs, err = repo.List(context.Background(), filter)
	assert.NoError(t, err)
	assert.Len(t, logs, 1)
	assert.Equal(t, domain.AuditEventTypeUserLogin, logs[0].EventType)

	// Filter by actor
	filter = domain.AuditLogFilter{TenantID: "tenant-1", ActorID: "user-1"}
	logs, err = repo.List(context.Background(), filter)
	assert.NoError(t, err)
	assert.Len(t, logs, 1)
}

func TestAuditLogRepository_Count(t *testing.T) {
	repo := newFakeAuditLogRepository()

	log := &domain.AuditLog{TenantID: "tenant-1", EventType: domain.AuditEventTypeUserCreated, ActorID: "user-1", Action: "Created"}
	repo.Create(context.Background(), log)

	count, err := repo.Count(context.Background(), domain.AuditLogFilter{TenantID: "tenant-1"})
	assert.NoError(t, err)
	assert.Equal(t, int64(1), count)
}

func TestAuditLogRepository_VerifyChain(t *testing.T) {
	repo := newFakeAuditLogRepository()

	valid, err := repo.VerifyChain(context.Background(), "tenant-1", time.Now().Add(-time.Hour))
	assert.NoError(t, err)
	assert.True(t, valid)
}